{{/* @dot github.com/donseba/go-webthings/admin.ScheduledPanel */}}
<section id="dashboard-scheduled" class="dashboard-panel" aria-labelledby="dashboard-scheduled-title">
    {{template "dashboard-panel-title" .Heading}}

    {{if .Items}}
        <ul class="dashboard-list">
            {{range .Items}}
                <li class="dashboard-row">
                    <svg class="icon" aria-hidden="true"><use href="{{importmap_url "icons.svg"}}#{{.Icon}}"/></svg>
                    <div class="dashboard-row-main">
                        <a href="{{.URL}}">{{.Title}}</a>
                        <span class="dashboard-meta">{{.Section}} · {{.Change}}</span>
                    </div>
                    <time class="dashboard-time" datetime="{{.Time}}">{{.When}}</time>
                </li>
            {{end}}
        </ul>
    {{else if not .Failed}}
        <p class="dashboard-empty">{{tl localizer "Nothing is scheduled. Plan a publication in the publication panel of a page or item."}}</p>
    {{end}}

    {{template "dashboard-failed" .PanelState}}
</section>
