{{/* @dot github.com/donseba/go-webthings/modules/gallery.ImagesView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{.Title}}</h1>
            <div class="admin-page-actions">
                <a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer "Image order")}}</a>
                <a class="button-secondary" href="{{.EditURL}}">{{tl localizer "Edit album"}}</a>
            </div>
        </header>

        <section class="surface border-theme border rounded-xl p-6">
            <table class="w-full">
                <thead>
                    <tr>
                        <th></th>
                        <th>{{tl localizer "Image"}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Images}}
                        <tr>
                            <td class="p-3">{{with .URL}}<img class="w-16 object-contain" src="{{.}}" alt="" loading="lazy">{{end}}</td>
                            <td class="p-3">{{.Name}}</td>
                            <td class="p-3">
                                <div class="row-actions">
                                    {{template "admin-moves" .Moves}}
                                </div>
                            </td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="3">{{tl localizer "This album has no images yet. Choose them in the album."}}</td></tr>
                    {{end}}
                </tbody>
            </table>
        </section>
    </div>
</main>
