{{/* @dot github.com/donseba/go-webthings/modules/gallery.OrderView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer "Image order"}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .BackLabel)}}</a>
            </div>
        </header>

        <section class="surface border-theme border rounded-xl p-6">
            <p class="muted mb-4">{{tl localizer "Choose an album to put its images in order."}}</p>

            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Album"}}</th>
                        <th class="numeric">{{tl localizer "Images"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Albums}}
                        <tr>
                            <td class="p-3"><a href="{{.URL}}">{{.Title}}</a></td>
                            <td class="p-3 numeric">{{.Images}}</td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="2">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>
        </section>
    </div>
</main>
