{{/* @dot github.com/donseba/go-webthings/modules/gallery.Album */}}
<main id="content"><h1>{{.Title}}</h1>{{.Description}}
{{range .Images}}<img src="{{.URL}}" srcset="{{.Srcset}}" width="{{.Width}}" height="{{.Height}}" data-large="{{.LargeURL}}" alt="{{.Alt}}" title="{{.Title}}"><a href="{{.OriginalURL}}" download>Original</a>{{end}}</main>
