{{/* @dot github.com/donseba/go-webthings/modules/forms.InboxView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer "Submissions"}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                <a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .Title)}}</a>
            </div>
        </header>

        {{template "admin-tabs" .Filters}}

        <section class="card">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Received"}}</th>
                        <th>{{tl localizer "Language"}}</th>
                        <th>{{tl localizer "Answers"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3"><a href="{{.URL}}">{{.Date}}</a></td>
                            <td class="p-3">{{.Locale}}</td>
                            <td class="p-3">
                                {{.Summary}}
                                {{if .Archived}}<span class="badge">{{tl localizer "Archived"}}</span>{{end}}
                            </td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="3">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>

            {{template "admin-pager" .Pager}}
        </section>
    </div>
</main>
