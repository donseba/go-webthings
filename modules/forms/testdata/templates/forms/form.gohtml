{{/* @dot github.com/donseba/go-webthings/modules/forms.FormView */}}
<main id="content"><h1>{{.Title}}</h1>
{{if .Sent}}<div class="success">{{.Success}}</div>{{else}}{{.Intro}}
{{if .Throttled}}<p class="throttled">throttled</p>{{end}}
{{form_open .Form}}{{range .Fields}}{{form_field $.Form . $.Errors}}{{end}}<button>Send</button>{{form_close}}{{end}}</main>
