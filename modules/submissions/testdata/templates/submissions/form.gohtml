{{/* @dot github.com/donseba/go-webthings/modules/submissions.FormView */}}
<main id="content"><h1>{{.Title}}</h1>
<p id="result">{{.Result}}</p>
<p id="func-result">{{submitResult "tips"}}</p>
{{with submitInput "tips"}}{{form_open .}}
{{form_field . "name" nil}} {{form_field . "email" nil}} {{form_field . "title" nil}} {{form_field . "text" nil}} {{form_field . "image" nil}}
{{form_close}}{{end}}
</main>
