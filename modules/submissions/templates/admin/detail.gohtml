{{/* @dot github.com/donseba/go-webthings/modules/submissions.DetailView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{.Subject}}</h1>
            <div class="admin-page-actions"><a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .Title)}}</a></div>
        </header>

        <div class="grid lg:grid-cols-3 gap-6 items-start">
            <section class="surface border-theme border rounded-xl p-6 lg:col-span-2">
                <div class="whitespace-pre-wrap">{{.Body}}</div>

                {{with .ImageURL}}
                    <a href="{{.}}" target="_blank" rel="noopener"><img class="w-full max-h-64 object-contain mt-6" src="{{.}}" alt=""></a>
                {{end}}
            </section>

            <section class="surface border-theme border rounded-xl p-6">
                <dl class="grid gap-5">
                    <div><dt class="muted text-sm">{{tl localizer "Name"}}</dt><dd>{{.Name}}</dd></div>
                    <div><dt class="muted text-sm">{{tl localizer "Email"}}</dt><dd class="break-all"><a href="mailto:{{.Email}}">{{.Email}}</a></dd></div>
                    <div><dt class="muted text-sm">{{tl localizer "Received"}}</dt><dd>{{.Date}}</dd></div>
                    <div><dt class="muted text-sm">{{tl localizer "Language"}}</dt><dd>{{.Locale}}</dd></div>
                    <div>
                        <dt class="muted text-sm">{{tl localizer "Status"}}</dt>
                        <dd>
                            {{tl localizer .Status}}
                            {{with .Decided}}<span class="muted text-sm"> · {{.}} · {{$.DecidedBy}}</span>{{end}}
                        </dd>
                    </div>
                </dl>

                {{with .PostURL}}
                    <a class="button mt-6" href="{{.}}">{{tl localizer "Open draft post"}}</a>
                {{end}}

                {{if or .Accept .Reject .Delete}}
                    <div class="card-footer action-bar">
                        {{with .Accept}}{{form_render_localized localizer . nil}}{{end}}
                        {{with .Reject}}{{form_render_localized localizer . nil}}{{end}}
                        {{with .Delete}}{{form_render_localized localizer . nil}}{{end}}
                    </div>
                {{end}}
            </section>
        </div>
    </div>
</main>
