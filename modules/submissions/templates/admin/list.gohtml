{{/* @dot github.com/donseba/go-webthings/modules/submissions.ListView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer .Title}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                {{with .SettingsURL}}<a class="button-secondary" href="{{.}}">{{tl localizer "Settings"}}</a>{{end}}
            </div>
        </header>

        {{template "admin-tabs" .Filters}}

        <section class="card">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Received"}}</th>
                        <th>{{tl localizer "Title"}}</th>
                        <th>{{tl localizer "Name"}}</th>
                        <th>{{tl localizer "Language"}}</th>
                        <th>{{tl localizer "Status"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3"><a href="{{.URL}}">{{.Date}}</a></td>
                            <td class="p-3"><a href="{{.URL}}">{{.Title}}</a></td>
                            <td class="p-3">{{.Name}}</td>
                            <td class="p-3">{{.Locale}}</td>
                            <td class="p-3">{{tl localizer .Status}}</td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="5">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>

            {{template "admin-pager" .Pager}}
        </section>
    </div>
</main>
