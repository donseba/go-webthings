{{/* @dot github.com/donseba/go-webthings/modules/registrations.OverviewView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer .Title}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                {{with .NewURL}}<a class="button" href="{{.}}">{{tl localizer "New subject"}}</a>{{end}}
            </div>
        </header>

        <section class="surface border-theme border rounded-xl p-6">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{if .Events}}{{tl localizer "Event"}}{{else}}{{tl localizer "Subject"}}{{end}}</th>
                        {{if .Events}}<th>{{tl localizer "Date"}}</th>{{end}}
                        <th>{{tl localizer "Status"}}</th>
                        <th>{{tl localizer "Registrations"}}</th>
                        <th>{{tl localizer "Places taken"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3"><a href="{{.URL}}">{{.Title}}</a></td>
                            {{if $.Events}}<td class="p-3">{{.Date}}</td>{{end}}
                            <td class="p-3"><span class="badge">{{tl localizer .Status}}</span></td>
                            <td class="p-3">{{.Registrations}}</td>
                            <td class="p-3">{{.Places}}</td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="5">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>
        </section>
    </div>
</main>
