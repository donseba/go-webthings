{{/* @dot github.com/donseba/go-webthings/modules/redirects.EditView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{.Title}}</h1>
            <div class="admin-page-actions"><a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .BackLabel)}}</a></div>
        </header>

        {{range .Warnings}}<p class="notice mb-6" role="status">{{.}}</p>{{end}}

        <section class="surface border-theme border rounded-xl p-6">
            {{form_render_localized localizer .Form .Errors}}

            {{if .Saved}}
                <dl class="grid sm:grid-cols-2 gap-4 card-footer">
                    <div><dt class="muted text-sm">{{tl localizer "Hits"}}</dt><dd>{{.Hits}}</dd></div>
                    <div><dt class="muted text-sm">{{tl localizer "Last hit"}}</dt><dd>{{.LastHit}}</dd></div>
                </dl>
            {{end}}

            {{with .Delete}}
                <div class="card-footer">{{form_render_localized localizer . nil}}</div>
            {{end}}
        </section>
    </div>
</main>
