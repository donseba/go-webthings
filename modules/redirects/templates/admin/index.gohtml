{{/* @dot github.com/donseba/go-webthings/modules/redirects.IndexView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer .Title}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.MissedURL}}">{{tl localizer "Missed paths"}}</a>
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                {{with .ImportURL}}<a class="button-secondary" href="{{.}}">{{tl localizer "Import"}}</a>{{end}}
                {{with .NewURL}}<a class="button" href="{{.}}">{{tl localizer "New redirect"}}</a>{{end}}
            </div>
        </header>

        <section class="card mb-6">
            {{form_render_localized localizer .TestForm nil}}

            {{with .Test}}
                <div id="test-result" class="mt-4">
                    {{if .Reserved}}
                        <p class="muted">{{tl localizer "This path belongs to the website itself and cannot be redirected."}}</p>
                    {{else}}
                        {{range .Steps}}
                            <p><a href="{{.URL}}">{{.From}}</a> → {{.To}} <span class="muted">({{.Status}})</span></p>
                        {{else}}
                            <p class="muted">{{tl localizer "No redirect for this path."}}</p>
                        {{end}}
                    {{end}}
                </div>
            {{end}}
        </section>

        <section class="card">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Old path"}}</th>
                        <th>{{tl localizer "New address"}}</th>
                        <th>{{tl localizer "Status"}}</th>
                        <th class="numeric">{{tl localizer "Hits"}}</th>
                        <th>{{tl localizer "Last hit"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3 break-all"><a href="{{.URL}}">{{.From}}</a></td>
                            <td class="p-3 break-all">
                                {{.To}}
                                {{if .Chained}}<span class="muted"> · {{tl localizer "Redirects again"}}</span>{{end}}
                            </td>
                            <td class="p-3">{{.Status}}</td>
                            <td class="p-3 numeric">{{.Hits}}</td>
                            <td class="p-3">{{.LastHit}}</td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="5">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>

            {{template "admin-pager" .Pager}}
        </section>
    </div>
</main>
