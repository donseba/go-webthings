{{/* @dot github.com/donseba/go-webthings/modules/redirects.ImportView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer "Import redirects"}}</h1>
            <div class="admin-page-actions"><a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .Title)}}</a></div>
        </header>

        {{if .Problems}}
            <ul class="surface border-theme border rounded-xl p-6 mb-6 grid gap-2">
                {{range .Problems}}<li>{{.}}</li>{{end}}
            </ul>
        {{end}}

        <section class="surface border-theme border rounded-xl p-6">
            {{form_render_localized localizer .Form .Errors}}
        </section>
    </div>
</main>
