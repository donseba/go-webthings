{{/* @dot github.com/donseba/go-webthings/modules/polls.ResultsView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer "Results"}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .Title)}}</a>
            </div>
        </header>

        {{range .Polls}}
            <section class="surface border-theme border rounded-xl p-6 mb-6">
                <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                    <h2 class="text-xl font-semibold"><a href="{{.EditURL}}">{{.Question}}</a></h2>
                    <span class="muted">{{tl localizer .Status}}</span>
                </div>

                <table class="w-full">
                    <thead>
                        <tr>
                            <th>{{tl localizer "Option"}}</th>
                            <th class="numeric">{{tl localizer "Votes"}}</th>
                            <th class="numeric">%</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .Options}}
                            <tr>
                                <td class="p-3">
                                    {{.Label}}
                                    <progress class="meter mt-1" max="100" value="{{.Percent}}">{{.Percent}}%</progress>
                                </td>
                                <td class="p-3 numeric">{{.Votes}}</td>
                                <td class="p-3 numeric">{{.Percent}}%</td>
                            </tr>
                        {{end}}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="p-3 font-semibold">{{tl localizer "Total"}}</td>
                            <td class="p-3 font-semibold numeric">{{.Total}}</td>
                            <td class="p-3"></td>
                        </tr>
                    </tfoot>
                </table>

                {{with .Reset}}
                    <div class="card-footer">{{form_render_localized localizer . nil}}</div>
                {{end}}
            </section>
        {{else}}
            <section class="surface border-theme border rounded-xl p-6">
                <p class="muted">{{template "admin-empty" Search}}</p>
            </section>
        {{end}}
    </div>
</main>
