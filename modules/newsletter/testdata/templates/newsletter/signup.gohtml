{{/* @dot github.com/donseba/go-webthings/modules/newsletter.SignupView */}}
<main id="content"><h1>{{.Title}}</h1>{{.Intro}}
{{with .Result}}<p class="result">result: {{.}}</p>{{end}}
{{form_open .Form}}{{form_field .Form "locale" nil}}{{form_field .Form "email" nil}}{{form_field .Form "name" nil}}<button>Subscribe</button>{{form_close}}</main>
