{{/* @dot github.com/donseba/go-webthings/modules/newsletter.MailingView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{.Title}}</h1>
            <div class="admin-page-actions"><a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer "Mailings")}}</a></div>
        </header>

        {{if .Sent}}
            {{/* While the mailing is sent, the progress refreshes itself. */}}
            <div id="mailing-progress" class="notice mb-6" role="status"
                {{if .Sending}}{{pollAttrs runtime .URL "every" "3s" "swap" "outerHTML" "select" "#mailing-progress"}}{{end}}>
                {{if .Sending}}
                    <p>{{tl localizer "Sending since %s: %d of %d messages sent." .Sent .Recipients .Total}} <a href="{{.URL}}">{{tl localizer "Refresh"}}</a></p>
                {{else}}
                    <p>{{tl localizer "Sent"}}: {{.Sent}} · {{tl localizer "Recipients"}}: {{.Recipients}}{{with .Finished}} · {{tl localizer "Finished"}}: {{.}}{{end}}</p>
                {{end}}

                {{if .Failed}}<p>{{tl localizer "Not delivered: %d. The server log has the reasons." .Failed}}</p>{{end}}
            </div>
        {{end}}

        {{if .Preview}}
            <section class="surface border-theme border rounded-xl p-6 mb-6">
                <h2 class="font-semibold mb-4">{{tl localizer "Preview"}}</h2>
                <p class="muted text-sm mb-4">
                    {{tl localizer "Subject"}}: {{.Subject}} ·
                    {{tl localizer "Language"}}: {{if .Language}}{{.Language}}{{else}}{{tl localizer "All languages"}}{{end}}
                </p>
                <div class="rich-content">{{.Preview}}</div>

                {{if not .Sent}}
                    <div class="card-footer">
                        <p class="muted mb-4">{{tl localizer "Confirmed subscribers who will receive this mailing"}}: {{.Audience}}</p>
                        {{with .Send}}{{form_render_localized localizer . nil}}{{end}}
                    </div>
                {{end}}
            </section>
        {{end}}

        {{if or .Form .Delete}}
            <section class="surface border-theme border rounded-xl p-6">
                {{with .Form}}{{form_render_localized localizer . $.Errors}}{{end}}

                {{with .Delete}}
                    <div class="card-footer">{{form_render_localized localizer . nil}}</div>
                {{end}}
            </section>
        {{end}}
    </div>
</main>
