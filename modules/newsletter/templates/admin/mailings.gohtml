{{/* @dot github.com/donseba/go-webthings/modules/newsletter.MailingsView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer "Mailings"}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                <a class="button-secondary" href="{{.BackURL}}">{{tl localizer "Back to %s" (tl localizer .Title)}}</a>
                {{with .NewURL}}<a class="button" href="{{.}}">{{tl localizer "New mailing"}}</a>{{end}}
            </div>
        </header>

        <section class="surface border-theme border rounded-xl p-6">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Subject"}}</th>
                        <th>{{tl localizer "Language"}}</th>
                        <th>{{tl localizer "Sent"}}</th>
                        <th>{{tl localizer "Recipients"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3"><a href="{{.URL}}">{{.Subject}}</a></td>
                            <td class="p-3">{{if .Language}}{{.Language}}{{else}}{{tl localizer "All languages"}}{{end}}</td>
                            <td class="p-3">{{if .Sending}}{{tl localizer "Sending"}}{{else if .Sent}}{{.Sent}}{{else}}{{tl localizer "Draft"}}{{end}}</td>
                            <td class="p-3">{{if .Sent}}{{.Recipients}}{{end}}</td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="4">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>
        </section>
    </div>
</main>
