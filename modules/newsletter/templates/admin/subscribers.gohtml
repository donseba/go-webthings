{{/* @dot github.com/donseba/go-webthings/modules/newsletter.SubscribersView */}}
{{/* @model Search github.com/donseba/go-webthings/admin.SearchBox */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer .Title}}</h1>
            <div class="admin-page-actions">
                {{template "admin-search" Search}}
                <a class="button-secondary" href="{{.TextsURL}}">{{tl localizer "Texts"}}</a>
                {{with .ImportURL}}<a class="button-secondary" href="{{.}}">{{tl localizer "Import CSV"}}</a>{{end}}
                {{with .ExportURL}}<a class="button-secondary" href="{{.}}">{{tl localizer "Export CSV"}}</a>{{end}}
                <a class="button-secondary" href="{{.TrashURL}}">{{tl localizer "Trash"}}</a>
                <a class="button" href="{{.MailingsURL}}">{{tl localizer "Mailings"}}</a>
            </div>
        </header>

        {{template "admin-tabs" .Filters}}

        <section class="card">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>{{tl localizer "Email"}}</th>
                        <th>{{tl localizer "Name"}}</th>
                        <th>{{tl localizer "Language"}}</th>
                        <th>{{tl localizer "Status"}}</th>
                        <th>{{tl localizer "Signed up"}}</th>
                        <th>{{tl localizer "Confirmed on"}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Rows}}
                        <tr>
                            <td class="p-3">{{.Email}}</td>
                            <td class="p-3">{{.Name}}</td>
                            <td class="p-3">{{.Locale}}</td>
                            <td class="p-3">{{tl localizer .Status}}</td>
                            <td class="p-3">{{.Created}}</td>
                            <td class="p-3">{{.Confirmed}}</td>
                            <td class="p-3"><div class="row-actions">{{with .Delete}}{{form_render_localized localizer . nil}}{{end}}</div></td>
                        </tr>
                    {{else}}
                        <tr><td class="p-3 muted" colspan="7">{{template "admin-empty" Search}}</td></tr>
                    {{end}}
                </tbody>
            </table>

            {{template "admin-pager" .Pager}}
        </section>
    </div>
</main>
