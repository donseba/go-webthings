{{/* @dot github.com/donseba/go-webthings/modules/stats.DashboardView */}}
<main id="content" class="admin-page">
    <div class="admin-page-body">
        <header class="admin-page-header">
            <h1 class="admin-page-title">{{tl localizer .Title}}</h1>
            <nav class="admin-page-actions" aria-label="{{tl localizer "Period"}}">
                {{range .Ranges}}
                    <a class="{{if .Active}}button{{else}}button-secondary{{end}}" href="{{.URL}}"
                       {{if .Active}}aria-current="page"{{end}}>{{tl localizer "%d days" .Days}}</a>
                {{end}}
            </nav>
        </header>

        <section class="stat-tiles">
            <div class="stat-tile">
                <p class="stat-label">{{tl localizer "Page views"}}</p>
                <p class="stat-value" id="stats-views">{{.Views}}</p>
            </div>
            <div class="stat-tile">
                <p class="stat-label">{{tl localizer "Visitors"}}</p>
                <p class="stat-value" id="stats-visitors">{{.Visitors}}</p>
            </div>
        </section>

        <section class="surface border-theme border rounded-xl p-6 mb-6">
            <h2 class="font-semibold mb-4">{{tl localizer "Page views per day"}}</h2>
            <div class="bar-chart" role="img" aria-label="{{tl localizer "Page views per day"}}">
                {{range .Bars}}
                    <span class="bar bar-{{.Height}}"
                          title="{{.Date}}: {{tl localizer "%d views, %d visitors" .Views .Visitors}}"></span>
                {{end}}
            </div>
            <div class="flex justify-between muted text-xs mt-2">
                <span>{{.From}}</span>
                <span>{{.To}}</span>
            </div>
            <p class="muted text-xs mt-3">{{tl localizer "A visitor is recognised for one day only: visitors are counted per day and added up."}}</p>
        </section>

        <section class="surface border-theme border rounded-xl p-6 mb-6">
            <h2 class="font-semibold mb-4">{{tl localizer "Top pages"}}</h2>
            {{template "stats-rows" .Pages}}
        </section>

        <section class="grid lg:grid-cols-3 gap-4 mb-6">
            <div class="surface border-theme border rounded-xl p-6">
                <h2 class="font-semibold mb-4">{{tl localizer "Referrers"}}</h2>
                {{template "stats-rows" .Referrers}}
            </div>
            <div class="surface border-theme border rounded-xl p-6">
                <h2 class="font-semibold mb-4">{{tl localizer "Devices"}}</h2>
                {{template "stats-rows" .Devices}}
            </div>
            <div class="surface border-theme border rounded-xl p-6">
                <h2 class="font-semibold mb-4">{{tl localizer "Languages"}}</h2>
                {{template "stats-rows" .Locales}}
            </div>
        </section>

        {{with .Settings}}
            <section class="surface border-theme border rounded-xl p-6">
                <h2 class="font-semibold mb-4">{{tl localizer "Settings"}}</h2>
                {{form_render_localized localizer . $.SettingsErrors}}
            </section>
        {{end}}
    </div>
</main>

{{define "stats-rows"}}
    {{/* @dot []github.com/donseba/go-webthings/modules/stats.Row */}}
    <table class="w-full">
        <thead>
            <tr>
                <th></th>
                <th class="numeric">{{tl localizer "Views"}}</th>
                <th class="numeric">{{tl localizer "Visitors"}}</th>
            </tr>
        </thead>
        <tbody>
            {{range .}}
                <tr>
                    <td class="p-2 min-w-0">
                        {{if .URL}}<a class="break-all" href="{{.URL}}" target="_blank" rel="noopener">{{.Name}}</a>{{else}}<span class="break-all">{{.Name}}</span>{{end}}
                        {{with .Detail}}<span class="block muted text-xs">{{.}}</span>{{end}}
                        <progress class="meter mt-1" max="100" value="{{.Share}}">{{.Share}}%</progress>
                    </td>
                    <td class="p-2 numeric">{{.Views}}</td>
                    <td class="p-2 numeric">{{.Visitors}}</td>
                </tr>
            {{else}}
                <tr><td class="p-2 muted" colspan="3">{{tl localizer "Nothing here yet."}}</td></tr>
            {{end}}
        </tbody>
    </table>
{{end}}
